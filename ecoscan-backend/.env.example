# ============================================================
# EcoScan Backend - variables d'environnement
# ============================================================
# Copie ce fichier vers .env puis remplace les valeurs de test
# par les vraies clés / endpoints de ton environnement.
# Ne jamais committer de vraies secrets dans le dépôt.
# ============================================================

# --- Django core ---
DJANGO_SECRET_KEY=change-me-very-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# --- Base de données ---
# Option 1: PostgreSQL local (recommandé pour le dev)
DB_BACKEND=postgresql
POSTGRES_DB=ecoscan
POSTGRES_USER=ecoscan
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Option 2: PostgreSQL via DATABASE_URL (prod / Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Frontend / app ---
# URL du back-office : l’écran d’activation du compte y est servi.
FRONTEND_URL=http://localhost:3001
# Transport e-mail : "smtp" ou "brevo". Brevo est conservé par défaut.
EMAIL_PROVIDER=brevo
# Pour utiliser SMTP, renseigner le backend et les paramètres de votre fournisseur.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EcoScan

# --- Auth / sécurité interne ---
DJANGO_INTERNAL_TOKEN=change-me-internal-token
AI_SERVICE_INTERNAL_TOKEN=change-me-ai-token

# --- AI service / FastAPI / assistant ---
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=60.0

# --- n8n / workflows ---
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_WEBHOOK_TOKEN=change-me-n8n-token
N8N_WEBHOOK_TIMEOUT=10.0
N8N_SHARED_SECRET=change-me-shared-secret
N8N_RELANCE_WEBHOOK_URL=http://localhost:5678/webhook/ecoscan-relance
N8N_INGESTION_TOKEN=change-me-ingestion-token
BACKEND_BASE_URL=http://127.0.0.1:8000

# --- Billing / paiement ---
# PayDunya test mode : pour tester sans vraie clé, garde PAYDUNYA_MODE=test
# mais les clés doivent être renseignées pour créer une vraie session de paiement.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# --- Energy / Woyofal / business settings ---
WOYOFAL_PRELEVEMENTS_PCT=0
ECOSCAN_VALIDATION_AUTO_RELEVES=True
ECOSCAN_TACHES_SYNCHRONES=False
ECOSCAN_REPORT_LOGO_PATH=

# --- Optional / custom ---
# Si tu ajoutes d'autres services plus tard, mets-les ici.
# Exemple: variables d'environnement spécifiques aux services externes

DJANGO_BASE_URL=https://api.example.com
DJANGO_INTERNAL_TOKEN=replace-with-the-same-secret-as-Django
HOME_ASSISTANT_URL=https://home-assistant.example.com
HOME_ASSISTANT_TOKEN=replace-with-a-home-assistant-long-lived-access-token
